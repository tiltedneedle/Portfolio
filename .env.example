# The Tilted Needle app's Supabase project: people sign in with their
# Tilted Needle account. Use that app's NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY values: both are public by design.
# Leave unset to preview the template with the door open. For a local
# stand-in instead, run `npm run double` and use
#   SUPABASE_URL=http://localhost:54321
#   SUPABASE_PUBLISHABLE_KEY=sb_publishable_double
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
